# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — ok anche come NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key server-only (sb_secret_...). Legacy SERVICE_ROLE JWT solo se ancora abilitato.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seed / test RLS (Fase 1)
SEED_TEST_PASSWORD=PartnerPortal!Test1

# Mokapen — obbligatori per Fase 0
MOKAPEN_CLIENT_ID=
MOKAPEN_CLIENT_SECRET=
MOKAPEN_ORG_ID=
# Opzionale: se assente, lo smoke test richiede un token fresco via client_credentials
MOKAPEN_ACCESS_TOKEN=
MOKAPEN_PARTNER_PIPELINE_ID=585
MOKAPEN_WEBHOOK_SECRET=
CRON_SECRET=
SLA_PP_EMAIL=
SLA_NAZIONALE_EMAIL=

# Owner Mokapen per i task creati dallo smoke test (id utente dedicato dell'app privata)
MOKAPEN_TASK_OWNER_ID=

# Opzionale: URL pubblico (tunnel / preview) che riceve POST per verificare deal.updated
SMOKE_WEBHOOK_URL=

# App / email
APP_BASE_URL=
RESEND_API_KEY=
EMAIL_FROM=Partner Portal <onboarding@resend.dev>
